{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kinetic-reader",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    { "binding": "AUTH_CODES", "id": "7348870b7ec3415ea3c4e751a860022c" }
  ],
  "ratelimits": [
    {
      "name": "TTS_RATE_LIMITER",
      "namespace_id": "1001",
      // 20 synthesis requests per minute per client IP
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "routes": [
    {
      "pattern": "kinreader.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kinreader.com",
      "custom_domain": true
    }
  ]
}
