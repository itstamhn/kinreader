{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinreader-audio-packager",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AudioPackager"
      ]
    },
    {
      "tag": "v2-convex-packaging",
      "deleted_classes": [
        "AudioPackager"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "kinetic-private-audio"
    }
  ],
  "vars": {
    "CONVEX_URL": "https://notable-camel-807.convex.cloud"
  },
  "workers_dev": true,
  "preview_urls": false
}
