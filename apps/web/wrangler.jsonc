{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kinetic-reader",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    // The origin Google redirects OAuth back to. It must match a registered
    // "Authorized redirect URI" in the Google Cloud console exactly:
    // https://kinreader.com/api/auth/google/callback
    "APP_ORIGIN": "https://kinreader.com"
  },
  "kv_namespaces": [
    { "binding": "AUTH_CODES", "id": "7348870b7ec3415ea3c4e751a860022c" }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      // 10 verify attempts per minute per client IP
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "routes": [
    {
      "pattern": "kinreader.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kinreader.com",
      "custom_domain": true
    }
  ]
}
