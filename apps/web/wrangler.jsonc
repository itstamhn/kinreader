{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kinetic-reader",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_ORIGIN": "https://app.kinreader.com",
    // Where /api/auth/* and /api/tts/* are proxied. Must match VITE_CONVEX_SITE_URL
    // in apps/web/.env.production, or the SPA and the proxy talk to two deployments.
    "CONVEX_SITE_ORIGIN": "https://notable-camel-807.convex.site"
  },
  // The reader only. The apex and www belong to the Astro marketing site,
  // deployed from apps/marketing with its own wrangler config (plan 014).
  "routes": [
    {
      "pattern": "app.kinreader.com",
      "custom_domain": true
    }
  ]
}
