---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Absolute URL. Defaults to the generated card for the site itself. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Set on pages that exist for crawlers rather than for readers. */
  noIndex?: boolean;
}

const {
  title,
  description,
  ogImage = new URL('/api/og?title=Kinreader%20%E2%80%94%20Made%20to%20Listen&author=Kinreader', Astro.site).href,
  ogType = 'website',
  noIndex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@KinreaderFM" />
    <meta name="twitter:creator" content="@KinreaderFM" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0B0C10" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Kinreader" href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Spline+Sans+Mono:ital,wght@0,300..700;1,300..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-kinreader-radial min-h-screen font-sans">
    <header class="max-w-3xl mx-auto px-6 py-6 flex items-center justify-between">
      <a href="/" class="font-serif text-lg text-cream tracking-tight">
        Kinreader<span class="text-amber">.</span>
      </a>
      <nav class="flex items-center gap-5 font-sans text-xs">
        <a href="/blog" class="text-paper/60 hover:text-paper transition">Blog</a>
        <a
          href="https://app.kinreader.com"
          class="px-3 py-1.5 rounded-full bg-amber/15 border border-amber/35 text-amber font-semibold hover:bg-amber/25 transition"
        >
          Open the app
        </a>
      </nav>
    </header>

    <main class="max-w-3xl mx-auto px-6 pb-20">
      <slot />
    </main>

    <footer class="max-w-3xl mx-auto px-6 py-10 border-t border-white/10">
      <p class="font-mono text-[11px] text-paper/35">
        © {new Date().getFullYear()} Kinreader · <a href="/rss.xml" class="hover:text-paper transition">RSS</a>
      </p>
    </footer>
  </body>
</html>
