---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base
  title="Kinreader — Made to Listen"
  description="The 60 FPS kinetic audio reader for X articles, newsletters and longform essays. Listen with synchronized typography at 0.8x to 3.5x speed."
>
  <script src="/pwa-redirect.js" defer is:inline></script>

  <section class="py-16 sm:py-24">
    <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-amber mb-5">
      Made to listen
    </p>
    <h1 class="font-serif text-4xl sm:text-6xl text-cream tracking-tight leading-[1.05]">
      Read with your ears,<br />one line at a time.
    </h1>
    <p class="font-sans text-sm sm:text-base text-paper/60 mt-6 max-w-xl leading-relaxed">
      Kinreader turns any article, newsletter or X thread into 60 FPS kinetic typography,
      synchronized word by word with natural speech. Paste a link, press play, keep moving.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="https://app.kinreader.com"
        class="px-5 py-3 rounded-2xl bg-amber text-ink font-sans text-sm font-semibold hover:brightness-110 transition"
      >
        Start listening
      </a>
      <a href="/blog" class="px-5 py-3 rounded-2xl border border-white/10 font-sans text-sm text-paper/70 hover:text-paper hover:border-white/25 transition">
        Read the blog
      </a>
    </div>
  </section>

  <section class="grid sm:grid-cols-3 gap-4 py-8">
    {[
      { t: 'Kinetic RSVP', d: 'One line, word-by-word focus at 60 FPS. No scrolling, no losing your place.' },
      { t: 'Any source', d: 'Articles, Substack posts, X threads — paste a URL and it extracts the text.' },
      { t: '0.8x to 3.5x', d: 'Speed up without the chipmunk artefacts, and keep the timing synchronized.' },
    ].map((f) => (
      <div class="p-5 rounded-2xl bg-surface border border-white/10">
        <h2 class="font-sans text-sm font-semibold text-cream">{f.t}</h2>
        <p class="font-sans text-xs text-paper/50 mt-1.5 leading-relaxed">{f.d}</p>
      </div>
    ))}
  </section>

  {posts.length > 0 && (
    <section class="py-10">
      <h2 class="font-serif text-2xl text-cream tracking-tight mb-5">Latest writing</h2>
      <ul class="space-y-3">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group block p-4 rounded-2xl border border-white/10 hover:border-amber/40 transition">
              <span class="font-sans text-sm font-semibold text-cream group-hover:text-amber transition">
                {post.data.title}
              </span>
              <span class="block font-sans text-xs text-paper/45 mt-1">{post.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
