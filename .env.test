# Bun does not load .env.local when NODE_ENV=test (by design, so tests are
# reproducible for everyone). src/lib/convex.tsx constructs a ConvexReactClient
# at module scope, which throws without an address, so tests that import
# App.tsx (transitively importing src/lib/convex.tsx) need these defined.
# These are the same public, non-secret dev-deployment URLs from .env.local
# (VITE_CONVEX_URL/VITE_CONVEX_SITE_URL are embedded in the client bundle
# anyway) -- no live network call to them happens during the test suite.
VITE_CONVEX_URL=https://cheerful-peccary-868.eu-west-1.convex.cloud
VITE_CONVEX_SITE_URL=https://cheerful-peccary-868.eu-west-1.convex.site
